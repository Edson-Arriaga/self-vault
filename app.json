{
  "expo": {
    "name": "Self Vault",
    "slug": "self-vault",
    "version": "1.0.2",
    "backgroundColor": "#FEFAE0",
    "orientation": "portrait",
    "icon": "./assets/images/self-vault-adaptive-icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/self-vault-adaptive-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#FEFAE0"
    },
    "android": {
      "package": "com.edsonarri20.selfvault",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/self-vault-adaptive-icon.png",
        "backgroundColor": "#FEFAE0"
      }
    },
    "plugins": [
      "expo-font",
      "expo-image-picker",
      "expo-sqlite"
    ],
    "extra": {
      "eas": {
        "projectId": "25f6f6a1-24d9-442a-a461-e21323bc68e3"
      }
    },
    "web": {
      "bundler": "metro"
    }
  }
}
